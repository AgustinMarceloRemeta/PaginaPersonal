---
import { Footer } from "@/components/footer";
import { GameCard } from "@/components/game-card";
import { Navbar } from "@/components/navbar";
import { useTranslations } from "@/i18n/utils";
import { academicGames, featuredGame, games } from "@/lib/games";
import { withBase } from "@/lib/utils";
import { Gamepad2, GraduationCap, Star } from "lucide-react";
import type { ui } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout title="Agustín Remeta" lang={lang}>
  <div class="relative min-h-screen flex flex-col bg-background">
    <Navbar lang={lang} client:load />

    <main class="flex-1">
      <section
        class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center text-center px-4 py-8 overflow-hidden"
      >
        <img
          src={withBase("/images/Fondo.jpg")}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none select-none"
        />
        <div
          class="absolute inset-0 bg-gradient-to-b from-background/20 via-transparent to-background pointer-events-none"
        />
        <div class="relative z-10 flex flex-col items-center gap-6 max-w-2xl">
          <img
            src={withBase("/images/profile.jpg")}
            alt={t("hero.name")}
            class="h-44 w-44 md:h-56 md:w-56 rounded-full object-cover border-2 border-primary/60 pointer-events-none drop-shadow-[0_0_35px_hsl(var(--primary)/0.3)]"
          />
          <h1 class="text-4xl md:text-6xl font-bold tracking-tight">{t("hero.name")}</h1>
          <p class="text-base md:text-lg text-muted-foreground leading-relaxed">
            {t("hero.description")}
          </p>
        </div>
      </section>

      <section class="py-24 px-4 bg-card z-10" id="featured">
        <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-10 xl:px-12 2xl:px-16">
          <div class="flex items-center gap-3 mb-12">
            <Star className="w-8 h-8 text-primary" />
            <h2 class="text-4xl font-bold tracking-tight">{t("featured.title")}</h2>
          </div>
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <img
              src={withBase(featuredGame.image)}
              alt={featuredGame.title}
              loading="lazy"
              decoding="async"
              class="w-full rounded-lg border border-primary/40 object-cover aspect-video shadow-lg shadow-primary/10"
            />
            <div class="space-y-6">
              <h3 class="text-3xl font-bold tracking-tight">{t(featuredGame.titleKey)}</h3>
              <p class="text-muted-foreground leading-relaxed">
                {t(featuredGame.descriptionKey)}
              </p>
              <div class="flex flex-col items-start gap-4">
                <a
                  href={featuredGame.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-4 p-2 pr-6 rounded-xl border border-primary/50 bg-secondary/50 hover:bg-primary hover:text-primary-foreground transition-all duration-300 hover:scale-[1.02] shadow-md shadow-primary/10 group"
                >
                  <img
                    src={withBase(featuredGame.steamLogo)}
                    alt="Steam"
                    loading="lazy"
                    decoding="async"
                    class="h-14 aspect-video object-cover rounded-lg border border-primary/30"
                  />
                  <span class="font-semibold text-base tracking-tight">
                    {t(featuredGame.linkLabelKey)} →
                  </span>
                </a>
                <a
                  href={featuredGame.studioLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-4 p-2 pr-6 rounded-xl border border-primary/50 bg-secondary/50 hover:bg-primary hover:text-primary-foreground transition-all duration-300 hover:scale-[1.02] shadow-md shadow-primary/10 group"
                >
                  <img
                    src={withBase(featuredGame.studioLogo)}
                    alt="Crestfallen Game Studio"
                    loading="lazy"
                    decoding="async"
                    class="h-14 aspect-video object-cover object-center rounded-lg border border-primary/30 bg-zinc-900"
                  />
                  <span class="font-semibold text-base tracking-tight">
                    {t(featuredGame.studioLabelKey)} →
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-24 px-4 bg-background" id="games">
        <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-10 xl:px-12 2xl:px-16">
          <div class="flex items-center gap-3 mb-12">
            <Gamepad2 className="w-8 h-8 text-primary" />
            <h2 class="text-4xl font-bold tracking-tight">{t("games.title")}</h2>
          </div>
          <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">
            {games.map((game) => <GameCard game={game} lang={lang} />)}
          </div>
        </div>
      </section>

      <section class="py-14 px-4 bg-card/40 border-t border-primary/10" id="academic">
        <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-10 xl:px-12 2xl:px-16">
          <div class="flex items-center gap-2.5 mb-6">
            <GraduationCap className="w-6 h-6 text-primary/80" />
            <h2 class="text-2xl font-bold tracking-tight text-foreground/90">
              {t("academic.title")}
            </h2>
          </div>
          <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4 max-w-6xl">
            {academicGames.map((game) => <GameCard game={game} lang={lang} compact />)}
          </div>
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
